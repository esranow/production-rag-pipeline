# Application Configuration
APP_NAME=Production-RAG-Pipeline
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
DEFAULT_LLM_MODEL=gemini-2.5-flash-lite
DEFAULT_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072

# Storage & Vector DB
VECTOR_STORE_BACKEND=local       # 'local' (zero-docker persistent) or 'qdrant'
LOCAL_STORAGE_PATH=data/vector_store.json
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=production_knowledge_base
QDRANT_API_KEY=

# Retrieval & Reranker Settings
TOP_K_RETRIEVAL=10
TOP_K_RERANK=4
HYBRID_ALPHA=0.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MIN_SIMILARITY_SCORE=0.35

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL_SECONDS=3600
